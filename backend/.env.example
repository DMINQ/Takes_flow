# Copy to .env and adjust. Defaults suit local CPU dev via docker compose.

# --- Database (local container OR remote "by link") ---
DB_HOST=db
DB_NAME=takeflow
DB_USER=postgres
DB_PASSWORD=postgres
# Set to override the assembled URL entirely (remote managed Postgres):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Broker (FastStream) ---
BROKER_PROVIDER=redis          # redis | nats
BROKER_URL=redis://redis:6379

# --- Transcription ---
TRANSCRIBER_PROVIDER=local     # local | remote
TRANSCRIBER_MODEL=base         # tiny|base|small|medium|large-v3
TRANSCRIBER_DEVICE=cpu         # auto|cpu|cuda
TRANSCRIBER_COMPUTE_TYPE=int8  # int8 (CPU) | float16 (GPU)
# TRANSCRIBER_REMOTE_URL=http://whisper:9000/asr

# --- Diarization (speaker separation) ---
DIARIZER_PROVIDER=stub         # off | stub | pyannote
# DIARIZER_HF_TOKEN=hf_...      # required for pyannote

# --- LLM (semantic bad-take detection; optional) ---
LLM_PROVIDER=off               # off | local | remote
# LLM_URL=
# LLM_API_KEY=
LLM_SIMILARITY_THRESHOLD=0.75

# --- Storage ---
STORAGE_PROVIDER=local          # local | s3
# S3/MinIO (used when STORAGE_PROVIDER=s3)
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_BUCKET=takeflow
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=us-east-1
# --- Presigned direct upload ---
STORAGE_PRESIGN_TTL_SECONDS=3600
# REQUIRED (real secret) when STORAGE_PROVIDER=local and APP_DEBUG=false —
# the process refuses to start with the placeholder below outside debug mode.
STORAGE_PRESIGN_SECRET=dev-only-insecure-presign-secret
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000
STORAGE_SESSION_REAP_AFTER_SECONDS=86400

# --- App ---
APP_CORS_ORIGINS=*
APP_MAX_UPLOAD_BYTES=2147483648
APP_LOG_LEVEL=INFO
