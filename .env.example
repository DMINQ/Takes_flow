# Copy to .env (same directory as docker-compose.yml) and adjust for your
# environment: local | develop | prod. The api/worker/relay services load
# this file wholesale via `env_file:` — every var here reaches the container
# as-is, so nothing needs to be duplicated inline in docker-compose.yml.
# DB_HOST and BROKER_URL are the two exceptions: compose always overrides
# them to the container-network addresses (db/redis), regardless of what you
# set here, because those only make sense inside the compose network.

# --- App ---
# Local/dev stacks: true (lets the local storage adapter boot with the
# placeholder presign secret). MUST be false wherever the app is reachable
# outside your machine — the process refuses to start otherwise.
APP_DEBUG=true
APP_CORS_ORIGINS=*

# --- Database ---
DB_PASSWORD=postgres
# Remote/managed Postgres "by link" (overrides DB_HOST/NAME/USER/PASSWORD above):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Broker (FastStream) ---
BROKER_PROVIDER=redis          # redis | nats
BROKER_URL=redis://redis:6379

# --- Transcription ---
TRANSCRIBER_PROVIDER=local     # local | remote
TRANSCRIBER_MODEL=base         # tiny|base|small|medium|large-v3
TRANSCRIBER_DEVICE=cpu         # auto|cpu|cuda
TRANSCRIBER_COMPUTE_TYPE=int8  # int8 (CPU) | float16 (GPU)

# --- Diarization ---
DIARIZER_PROVIDER=stub         # off | stub | pyannote

# --- LLM (optional) ---
LLM_PROVIDER=off               # off | local | remote

# --- Storage ---
STORAGE_PROVIDER=local         # local | s3
# S3/MinIO (used when STORAGE_PROVIDER=s3; the `minio` compose service is the
# local target for these defaults — see docker-compose.yml)
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=takeflow
STORAGE_S3_ACCESS_KEY=takeflow
STORAGE_S3_SECRET_KEY=takeflow-dev-secret
STORAGE_S3_REGION=us-east-1
# REQUIRED (real secret) wherever APP_DEBUG=false and STORAGE_PROVIDER=local.
STORAGE_PRESIGN_SECRET=dev-only-insecure-presign-secret
