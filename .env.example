# --- App ---
# MUST be false wherever the app is reachable outside your machine — the
# process refuses to start otherwise.
APP_DEBUG=true
APP_CORS_ORIGINS=*
APP_MAX_UPLOAD_BYTES=34359738368
APP_LOG_LEVEL=INFO

# --- Database ---
DB_PASSWORD=postgres
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Broker (FastStream) ---
BROKER_PROVIDER=redis
BROKER_URL=redis://redis:6379

# --- Transcription ---
TRANSCRIBER_PROVIDER=local
TRANSCRIBER_MODEL=base
TRANSCRIBER_DEVICE=cpu
TRANSCRIBER_COMPUTE_TYPE=int8

# --- Diarization ---
DIARIZER_PROVIDER=stub

# --- LLM (optional) ---
LLM_PROVIDER=off
LLM_SIMILARITY_THRESHOLD=0.75

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=takeflow
STORAGE_S3_ACCESS_KEY=takeflow
STORAGE_S3_SECRET_KEY=takeflow-dev-secret
STORAGE_S3_REGION=us-east-1
# REQUIRED (real secret) wherever APP_DEBUG=false and STORAGE_PROVIDER=local.
STORAGE_PRESIGN_SECRET=dev-only-insecure-presign-secret
STORAGE_PRESIGN_TTL_SECONDS=3600
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000
STORAGE_SESSION_REAP_AFTER_SECONDS=86400
